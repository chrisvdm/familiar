{
  "name": "familiar-worker",
  "version": "1.0.0",
  "description": "familiar — Cloudflare Worker application",
  "private": true,
  "type": "module",
  "keywords": [],
  "author": "Chris van der Merwe",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "dev:init": "rw-scripts dev-init",
    "preview": "vite preview",
    "worker:run": "rw-scripts worker-run",
    "clean": "npm run clean:vite && npm run clean:do",
    "clean:vite": "rm -rf ./node_modules/.vite",
    "clean:do": "rm -rf .wrangler/state/v3/do",
    "memory": "node scripts/memory.mjs",
    "release": "node scripts/release.mjs",
    "generate": "rw-scripts ensure-env && wrangler types --include-runtime false",
    "check": "npm run generate && npm run types",
    "types": "tsc",
    "test": "node --experimental-strip-types --experimental-specifier-resolution=node --test \"src/**/*.test.ts\"",
    "test:e2e": "node --experimental-strip-types --experimental-specifier-resolution=node --test \"tests/e2e/**/*.e2e.test.ts\"",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "react-server-dom-webpack": "19.2.4",
    "rwsdk": "1.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@cloudflare/vite-plugin": "1.26.1",
    "@cloudflare/workers-types": "4.20260307.1",
    "@types/node": "~25.3.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "wrangler": "4.71.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
